# =====================================================================
#  Jalal Sons Cloth House - Apache rules (cPanel shared hosting / XAMPP)
# =====================================================================
Options -Indexes
ServerSignature Off
AddDefaultCharset UTF-8

# Friendly 404
ErrorDocument 404 /404.php

<IfModule mod_rewrite.c>
    RewriteEngine On
    # If the site lives in a sub-folder (e.g. /jalal-sons on XAMPP), set:
    # RewriteBase /jalal-sons/

    # --- Block web access to internal folders
    RewriteRule ^(config|classes|includes|database|storage)(/|$) - [F,L]
    RewriteRule (^|/)\.(git|env|htaccess) - [F,L]
    RewriteRule ^composer\.(json|lock)$ - [F,L]

    # --- Optional clean URLs (also set 'clean_urls' => true in config/config.php)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^product/([a-z0-9\-]+)/?$ product.php?slug=$1 [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^shop/([a-z0-9\-]+)/([a-z0-9\-]+)/?$ shop.php?category=$1&subcategory=$2 [L,QSA]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^shop/([a-z0-9\-]+)/?$ shop.php?category=$1 [L,QSA]
    RewriteRule ^sitemap\.xml$ sitemap.php [L]
</IfModule>

# --- Security headers (PHP also sends these; this covers static files)
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# --- Never serve these file types
<FilesMatch "\.(sql|log|ini|sample\.php|md|lock)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# --- Cache static assets
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/webp "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>

# --- PHP upload limits (ignored where PHP runs as FPM; set them in cPanel's MultiPHP INI Editor instead)
<IfModule mod_php.c>
    php_value upload_max_filesize 6M
    php_value post_max_size 50M
    php_value max_file_uploads 20
</IfModule>
